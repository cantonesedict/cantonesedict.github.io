      - _(2)ho (u/)(3)_
          [[ho2 wu3]]
          impudent, disagreeable;
      - _(2)ho (4)l(i/)n_
          [[ho2 lin4]],
          to compassionate;
      - _(2)ho (2)shai_
          [[ho2 sai2]],
          serviceable;
      - _(2)ho (5)(i/) ts(o\)(6) tak(7)_
          [[ho2 ji5 zou6 dak1]]
